#!/bin/sh
# Global pre-push policy: no direct pushes to protected branches, no force pushes.
set -u

PROTECTED_RE='^(main|master|develop|release/.*)$'
RED=$(printf '\033[31m'); YEL=$(printf '\033[33m'); DIM=$(printf '\033[2m'); RST=$(printf '\033[0m')
ZERO=0000000000000000000000000000000000000000

fail() {
  printf '\n%sx git-policy:%s %s\n' "$RED" "$RST" "$1" >&2
  _log="$HOME/.config/git-policy/state/blocks.log"
  mkdir -p "$(dirname "$_log")" 2>/dev/null
  printf '%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(basename "$0")" "$1" >> "$_log" 2>/dev/null
}
warn() { printf '\n%s! git-policy:%s %s\n' "$YEL" "$RST" "$1" >&2; }
note() { printf '%s  %s%s\n' "$DIM" "$1" "$RST" >&2; }

status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  # Branch deletion: allowed only for non-protected branches.
  if [ "$local_sha" = "$ZERO" ]; then
    rb=${remote_ref#refs/heads/}
    if printf '%s' "$rb" | grep -Eq "$PROTECTED_RE"; then
      fail "refusing to delete protected branch '$rb' on the remote."
      status=1
    fi
    continue
  fi

  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;   # tags and other refs are not policed here
  esac

  rb=${remote_ref#refs/heads/}

  # --- direct push to a protected branch ---
  if printf '%s' "$rb" | grep -Eq "$PROTECTED_RE"; then
    if [ "${GIT_POLICY_ALLOW_PUSH_MAIN:-0}" = "1" ]; then
      warn "pushing to protected branch '$rb' (override set)"
    else
      fail "refusing to push directly to protected branch '$rb'."
      note "push a feature branch and open a PR instead:"
      note "  git switch -c feat/<short-slug>"
      note "  git push -u origin feat/<short-slug>"
      note "  gh pr create --fill"
      note "one-off override:  GIT_POLICY_ALLOW_PUSH_MAIN=1 git push ..."
      status=1
      continue
    fi
  fi

  # --- force push detection: remote tip must be an ancestor of what we send ---
  if [ "$remote_sha" != "$ZERO" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      if printf '%s' "$rb" | grep -Eq "$PROTECTED_RE"; then
        fail "refusing to force-push protected branch '$rb'."
        note "this would rewrite shared history. No override for this one."
        status=1
        continue
      fi
      warn "force-push to '$rb' (rewrites remote history)."
      note "fine if the branch is yours and unmerged; never on a shared branch."
    fi
  fi
done

exit $status
