#!/bin/sh
# Global git hook dispatcher.
#   1. runs the policy hook of the same name (if any)
#   2. hands off to the repo's own hook of the same name (if any)
#
# Every hook name is a symlink to this file. Add machine-local behaviour
# (counters, notifications) above the policy call.
name=$(basename "$0")

# The installer records where the policy hooks live in _policy, so the repo
# can be cloned anywhere. Without that file, fall back to the documented path.
here=$(cd "$(dirname "$0")" 2>/dev/null && pwd)
policy_dir=$(cat "$here/_policy" 2>/dev/null)
[ -n "$policy_dir" ] || policy_dir="$HOME/.config/git-policy/hooks"
policy="$policy_dir/$name"
if [ -x "$policy" ]; then
  "$policy" "$@" || exit $?
fi

local="$(git rev-parse --git-common-dir 2>/dev/null)/hooks/$name"
[ -x "$local" ] && exec "$local" "$@"
exit 0
